+                        let result = unsafe { run(&cc, code, &mut b, &mut rb, &Helpers::new::<Ram>(), budget, entry, fm) };
+                        let done = result & 0xffff;
+                        assert!(done > 0 && done <= budget);
+                        if entry == 0 && budget >= 6 && count >= 2 && (!load || (fast && address < BASE + 65532)) { assert!(done >= 6); }
+                        let mut trap = None;
+                        for _ in 0..done {
+                            let index = ((a.pc - BASE) / 3) as usize;
+                            assert!(index < block.len());
+                            ra.note_pc(a.pc);
+                            if let Err(t) = exec_insn(&mut a, &mut ra, &block[index].insn) { trap = Some(t); break; }
+                        }
+                        assert_eq!(trap, b.jit_trap.take());
+                        same(&a, &b);
+                        assert_eq!(ra.noted, rb.noted);
+                        cases += 1;
+                    }
+                }
+            }
+        }
+    }
+    cases
+}
